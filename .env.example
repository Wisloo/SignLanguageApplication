# Copy to .env and fill in your own values.
# PostgreSQL connection string used by Prisma and Auth.js.
# The default above targets the bundled local dev cluster (see AGENTS.md -> Local database).
DATABASE_URL="postgresql://signbright@127.0.0.1:5433/signbright"
# Random secret for Auth.js sessions: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST="true"
# Google AI Studio API key used for cloud letter & sentence recognition (server-side only).
# Free tier is rate-limited and inputs may be used to improve Google's products.
GEMINI_API_KEY="replace-me"
# Optional: override the model used for recognition.
GEMINI_MODEL="gemini-3.6-flash"
