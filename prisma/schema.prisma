generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String?
  passwordHash    String
  guardianConsent Boolean    @default(false)
  consentAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  progress        Progress[]
}

model Progress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language        String
  letter          String
  attempts        Int      @default(0)
  successes       Int      @default(0)
  stars           Int      @default(0)
  lastPractisedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, language, letter])
}
